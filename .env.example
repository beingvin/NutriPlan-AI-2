# GEMINI_API_KEY: Required for backend/Netlify function Gemini AI calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_GEMINI_API_KEY: Optional client-side API key for static host fallback on Netlify.
VITE_GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_API_BASE_URL: Optional backend API URL if backend is hosted separately (e.g., https://my-backend.onrender.com).
VITE_API_BASE_URL=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
